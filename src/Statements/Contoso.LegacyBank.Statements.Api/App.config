<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="ContosoLegacyBank"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ContosoLegacyBank;Integrated Security=True;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="StatementsApiBaseUrl" value="http://localhost:8091/" />
    <add key="AccountsServiceEndpoint" value="net.tcp://localhost:8090/AccountService" />
  </appSettings>

  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="AccountServiceBinding" />
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:8090/AccountService"
                binding="netTcpBinding"
                bindingConfiguration="AccountServiceBinding"
                contract="Contoso.LegacyBank.Accounts.Contracts.IAccountService"
                name="AccountServiceClient" />
    </client>
  </system.serviceModel>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
