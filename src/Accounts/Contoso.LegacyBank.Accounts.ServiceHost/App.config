<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="ContosoLegacyBank"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ContosoLegacyBank;Integrated Security=True;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.serviceModel>
    <services>
      <service name="Contoso.LegacyBank.Accounts.Business.AccountService">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/AccountService" />
          </baseAddresses>
        </host>
        <!-- net.tcp (not basicHttpBinding) is used so the service can self-host on a
             non-admin account: WCF's HTTP self-host transport always registers the HTTP.SYS
             listener using a "+" wildcard prefix, which requires an elevated "netsh http add
             urlacl" reservation. net.tcp opens a plain TCP socket and needs no such grant. If
             you have admin rights and prefer SOAP/HTTP, add a basicHttpBinding endpoint here
             after running netsh http add urlacl (see docs/troubleshooting.md). -->
        <endpoint address="" binding="netTcpBinding" contract="Contoso.LegacyBank.Accounts.Contracts.IAccountService" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <serviceMetadata />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
